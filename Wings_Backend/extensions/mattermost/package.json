{
  "name": "@mechanical-wings/mattermost",
  "version": "2026.3.26",
  "description": "Wings🪽 Mattermost channel plugin",
  "type": "module",
  "dependencies": {
    "@sinclair/typebox": "0.34.48",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "mechanical-wings": "workspace:*"
  },
  "peerDependencies": {
    "mechanical-wings": ">=2026.3.26"
  },
  "peerDependenciesMeta": {
    "mechanical-wings": {
      "optional": true
    }
  },
  "mechanical-wings": {
    "extensions": [
      "./index.ts"
    ],
    "setupEntry": "./setup-entry.ts",
    "channel": {
      "id": "mattermost",
      "label": "Mattermost",
      "selectionLabel": "Mattermost (plugin)",
      "docsPath": "/channels/mattermost",
      "docsLabel": "mattermost",
      "blurb": "self-hosted Slack-style chat; install the plugin to enable.",
      "order": 65
    },
    "install": {
      "npmSpec": "@mechanical-wings/mattermost",
      "localPath": "extensions/mattermost",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.3.26"
    }
  }
}
