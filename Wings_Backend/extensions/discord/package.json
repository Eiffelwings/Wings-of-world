{
  "name": "@mechanical-wings/discord",
  "version": "2026.3.26",
  "description": "Wings🪽 Discord channel plugin",
  "type": "module",
  "dependencies": {
    "@buape/carbon": "0.0.0-beta-20260317045421",
    "@discordjs/voice": "^0.19.2",
    "discord-api-types": "^0.38.42",
    "https-proxy-agent": "^8.0.0",
    "opusscript": "^0.1.1"
  },
  "devDependencies": {
    "mechanical-wings": "workspace:*"
  },
  "peerDependencies": {
    "mechanical-wings": ">=2026.3.26"
  },
  "peerDependenciesMeta": {
    "mechanical-wings": {
      "optional": true
    }
  },
  "mechanical-wings": {
    "extensions": [
      "./index.ts"
    ],
    "setupEntry": "./setup-entry.ts",
    "channel": {
      "id": "discord",
      "label": "Discord",
      "selectionLabel": "Discord (Bot API)",
      "detailLabel": "Discord Bot",
      "docsPath": "/channels/discord",
      "docsLabel": "discord",
      "blurb": "very well supported right now.",
      "systemImage": "bubble.left.and.bubble.right"
    },
    "install": {
      "npmSpec": "@mechanical-wings/discord",
      "localPath": "extensions/discord",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.3.26"
    },
    "bundle": {
      "stageRuntimeDependencies": true
    },
    "release": {
      "publishToNpm": true
    }
  }
}
