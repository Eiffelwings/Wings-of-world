# Wings Of World environment
#
# Copy to `.env.local` for local development. Keep real secrets out of release
# bundles and rotate any key that was ever included in an exported zip.

# Server
HOST=127.0.0.1
PORT=3000

# Primary data directory. The older WINGS_DATA_DIR name is still accepted as a
# compatibility fallback, but new installs should use WINGS_OF_WORLD_DATA_DIR.
WINGS_OF_WORLD_DATA_DIR=./data

# Optional workspace roots for guarded file tools. Separate multiple paths with
# semicolons on Windows.
WINGS_OF_WORLD_WORKSPACE_ROOTS=

# Seeds applied only when no saved config exists yet. The Settings page becomes
# authoritative after the first save.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-codex

# Telegram bridge
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
WINGS_OF_WORLD_TELEGRAM_POLLING=true

# Optional memory/project paths
OBSIDIAN_VAULT_PATH=
WINGS_OF_WORLD_PROJECTS_ROOT=
